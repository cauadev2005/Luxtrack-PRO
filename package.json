{
  "name": "luxtrack-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node server/src/index.js\"",
    "build": "vite build",
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "db:up": "docker compose up -d luxtrack-db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d luxtrack-db",
    "db:logs": "docker compose logs -f luxtrack-db",
    "db:shell": "docker compose exec luxtrack-db psql -U luxtrack -d luxtrack"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@vitejs/plugin-react": "^5.0.4",
    "bootstrap-icons": "^1.13.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "vite": "^7.1.7",
    "ws": "^8.18.3"
  }
}
